using System;

class Program
{
    static void Main()
    {
        bool running = true;

        while (running)
        {
            // Step 3 - First number input
            Console.Write("Enter first number (integer): ");
            int num1 = Convert.ToInt32(Console.ReadLine());

            // Step 4 - Second number input
            Console.Write("Enter second number (integer): ");
            int num2 = Convert.ToInt32(Console.ReadLine());

            string operation = "";

            // Step 8 - keep asking until valid operation
            while (true)
            {
                Console.WriteLine("\nChoose Operation:");
                Console.WriteLine("+  Addition");
                Console.WriteLine("-  Subtraction");
                Console.WriteLine("*  Multiplication");
                Console.WriteLine("/  Division");
                Console.WriteLine("%  Modulo");
                Console.WriteLine("=  Exit");

                Console.Write("Enter operation: ");
                operation = Console.ReadLine();

                // validate operation
                if (operation == "+" || operation == "-" || 
                    operation == "*" || operation == "/" || 
                    operation == "%" || operation == "=")
                {
                    break;
                }
                else
                {
                    Console.WriteLine("Incorrect Operation Used, please try again\n");
                }
            }

            // Step 7 - call Calculator function
            if (operation == "=")
            {
                running = false;
                Console.WriteLine("Program exited.");
            }
            else
            {
                Calculator(num1, num2, operation);
            }

            Console.WriteLine();
        }
    }

    // Separate Calculator function using switch-case
    static void Calculator(int num1, int num2, string operation)
    {
        switch (operation)
        {
            case "+":
                Console.WriteLine("Result: " + (num1 + num2));
                break;

            case "-":
                Console.WriteLine("Result: " + (num1 - num2));
                break;

            case "*":
                Console.WriteLine("Result: " + (num1 * num2));
                break;

            case "/":
                if (num2 == 0)
                {
                    Console.WriteLine("Cannot divide by zero");
                }
                else
                {
                    double result = (double)num1 / num2;
                    Console.WriteLine("Result: " + result);
                }
                break;

            case "%":
                if (num2 == 0)
                {
                    Console.WriteLine("Cannot modulo by zero");
                }
                else
                {
                    Console.WriteLine("Result: " + (num1 % num2));
                }
                break;
        }
    }
}
